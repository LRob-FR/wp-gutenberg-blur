#: assets/editor.js
msgid "Blur Effect"
msgstr "Efekt rozmycia"

#: assets/editor.js
msgid "Enable Blur Effect"
msgstr "Włącz efekt rozmycia"

#: assets/editor.js
msgid "Background Color"
msgstr "Kolor tła"

#: assets/editor.js
msgid "Background"
msgstr "Tło"

#: assets/editor.js
msgid "Background Opacity (%)"
msgstr "Przezroczystość tła (%)"

#: assets/editor.js
msgid "Controls the opacity of the background color."
msgstr "Kontroluje przezroczystość koloru tła."

#: assets/editor.js
msgid "Blur Intensity (px)"
msgstr "Intensywność rozmycia (px)"

#: assets/editor.js
msgid "Backdrop blur strength in pixels."
msgstr "Siła rozmycia tła w pikselach."

#: assets/editor.js
msgid "Saturation (%)"
msgstr "Nasycenie (%)"

#: assets/editor.js
msgid "Backdrop saturation level (100% = neutral)."
msgstr "Poziom nasycenia tła (100% = neutralny)."

#: lrob-gutenberg-blur.php
msgid "Adds backdrop blur effects to Gutenberg blocks (Group, Columns, Column, Row, Cover) with customizable background color, opacity, blur intensity, and saturation controls."
msgstr "Dodaje efekty rozmycia tła do bloków Gutenberg (Grupa, Kolumny, Kolumna, Wiersz, Okładka) z konfigurowalnymi kontrolkami koloru tła, przezroczystości, intensywności rozmycia i nasycenia."
