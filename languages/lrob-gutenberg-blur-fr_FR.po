#: assets/editor.js
msgid "Blur Effect"
msgstr "Effet de flou"

#: assets/editor.js
msgid "Enable Blur Effect"
msgstr "Activer l'effet de flou"

#: assets/editor.js
msgid "Background Color"
msgstr "Couleur d'arrière-plan"

#: assets/editor.js
msgid "Background"
msgstr "Arrière-plan"

#: assets/editor.js
msgid "Background Opacity (%)"
msgstr "Opacité de l'arrière-plan (%)"

#: assets/editor.js
msgid "Controls the opacity of the background color."
msgstr "Contrôle l'opacité de la couleur d'arrière-plan."

#: assets/editor.js
msgid "Blur Intensity (px)"
msgstr "Intensité du flou (px)"

#: assets/editor.js
msgid "Backdrop blur strength in pixels."
msgstr "Force du flou d'arrière-plan en pixels."

#: assets/editor.js
msgid "Saturation (%)"
msgstr "Saturation (%)"

#: assets/editor.js
msgid "Backdrop saturation level (100% = neutral)."
msgstr "Niveau de saturation de l'arrière-plan (100% = neutre)."

#: lrob-gutenberg-blur.php
msgid "Adds backdrop blur effects to Gutenberg blocks (Group, Columns, Column, Row, Cover) with customizable background color, opacity, blur intensity, and saturation controls."
msgstr "Ajoute des effets de flou d'arrière-plan aux blocs Gutenberg (Groupe, Colonnes, Colonne, Ligne, Couverture) avec des contrôles personnalisables de couleur d'arrière-plan, d'opacité, d'intensité de flou et de saturation."
