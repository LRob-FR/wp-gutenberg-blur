#: assets/editor.js
msgid "Blur Effect"
msgstr "Vervagingseffect"

#: assets/editor.js
msgid "Enable Blur Effect"
msgstr "Vervagingseffect inschakelen"

#: assets/editor.js
msgid "Background Color"
msgstr "Achtergrondkleur"

#: assets/editor.js
msgid "Background"
msgstr "Achtergrond"

#: assets/editor.js
msgid "Background Opacity (%)"
msgstr "Achtergrond dekking (%)"

#: assets/editor.js
msgid "Controls the opacity of the background color."
msgstr "Regelt de dekking van de achtergrondkleur."

#: assets/editor.js
msgid "Blur Intensity (px)"
msgstr "Vervagingsintensiteit (px)"

#: assets/editor.js
msgid "Backdrop blur strength in pixels."
msgstr "Achtergrondvervagingssterkte in pixels."

#: assets/editor.js
msgid "Saturation (%)"
msgstr "Verzadiging (%)"

#: assets/editor.js
msgid "Backdrop saturation level (100% = neutral)."
msgstr "Achtergrondverzadigingsniveau (100% = neutraal)."

#: lrob-gutenberg-blur.php
msgid "Adds backdrop blur effects to Gutenberg blocks (Group, Columns, Column, Row, Cover) with customizable background color, opacity, blur intensity, and saturation controls."
msgstr "Voegt achtergrondvervagingseffecten toe aan Gutenberg-blokken (Groep, Kolommen, Kolom, Rij, Omslag) met aanpasbare achtergrondkleur, dekking, vervagingsintensiteit en verzadigingsregelaars."
