#: assets/editor.js
msgid "Blur Effect"
msgstr "Effetto sfocatura"

#: assets/editor.js
msgid "Enable Blur Effect"
msgstr "Attiva effetto sfocatura"

#: assets/editor.js
msgid "Background Color"
msgstr "Colore di sfondo"

#: assets/editor.js
msgid "Background"
msgstr "Sfondo"

#: assets/editor.js
msgid "Background Opacity (%)"
msgstr "Opacità dello sfondo (%)"

#: assets/editor.js
msgid "Controls the opacity of the background color."
msgstr "Controlla l'opacità del colore di sfondo."

#: assets/editor.js
msgid "Blur Intensity (px)"
msgstr "Intensità della sfocatura (px)"

#: assets/editor.js
msgid "Backdrop blur strength in pixels."
msgstr "Intensità della sfocatura dello sfondo in pixel."

#: assets/editor.js
msgid "Saturation (%)"
msgstr "Saturazione (%)"

#: assets/editor.js
msgid "Backdrop saturation level (100% = neutral)."
msgstr "Livello di saturazione dello sfondo (100% = neutro)."

#: lrob-gutenberg-blur.php
msgid "Adds backdrop blur effects to Gutenberg blocks (Group, Columns, Column, Row, Cover) with customizable background color, opacity, blur intensity, and saturation controls."
msgstr "Aggiunge effetti di sfocatura dello sfondo ai blocchi Gutenberg (Gruppo, Colonne, Colonna, Riga, Copertina) con controlli personalizzabili per colore di sfondo, opacità, intensità della sfocatura e saturazione."
